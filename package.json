{
  "name": "orbia-lumia-companion",
  "private": true,
  "version": "0.0.0",
  "description": "O.R.B.I.A. / L.U.M.I.A. local-first holographic companion runtime.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "bridge": "node bridge/server.mjs",
    "bridge:writes": "JARVIS_ALLOW_WRITES=1 node bridge/server.mjs",
    "setup": "node scripts/setup.mjs",
    "start:local": "node scripts/start.mjs --local",
    "model:lumia": "node scripts/create-lumia-model.mjs",
    "start:lumia": "node scripts/start.mjs --lumia",
    "certify:lumia": "node scripts/certify-lumia-spanish.mjs",
    "certify:c1": "node scripts/certify-c1-contracts.mjs",
    "certify:c1:knowledge": "node scripts/certify-c1-knowledge.mjs",
    "certify:c1:tools": "node scripts/certify-c1-tools.mjs",
    "certify:c1:tool-runtime": "node scripts/certify-c1-tool-runtime.mjs",
    "certify:amr": "node scripts/certify-amr-model-runtime.mjs",
    "certify:vrm": "node scripts/certify-vrm-runtime.mjs",
    "certify:c1:voice-probe": "node scripts/certify-c1-local-voice-probe.mjs",
    "certify:c1:voice-adapters": "node scripts/certify-c1-local-voice-adapters.mjs",
    "voice:doctor": "node scripts/voice-doctor.mjs",
    "certify:vrm:runtime": "node scripts/certify-vrm-control-runtime.mjs",
    "certify:voice": "npm run certify:c1 && npm run certify:vrm && npm run certify:vrm:runtime && npm run certify:c1:voice-probe && npm run certify:c1:voice-adapters && npm run certify:voice-focus && npm run certify:diarization-probe && npm run certify:diarization-adapter && npm run certify:multivoice-stt && npm run certify:voice-gate && npm run certify:c1:tool-runtime",
    "voice:setup": "node scripts/setup-local-voice.mjs",
    "voice:setup:whisper": "node scripts/setup-local-voice.mjs --whisper-only",
    "voice:setup:kokoro": "node scripts/setup-local-voice.mjs --kokoro-only",
    "certify:voice-focus": "tsx scripts/certify-voice-focus.ts",
    "certify:diarization-probe": "node scripts/certify-speaker-diarization-probe.mjs",
    "voice:setup:diarization": "node scripts/setup-speaker-diarization.mjs",
    "certify:diarization-adapter": "node scripts/certify-speaker-diarization-adapter.mjs",
    "certify:multivoice-stt": "node scripts/certify-multivoice-stt.mjs",
    "voice:benchmark:multivoice": "node scripts/benchmark-multivoice.mjs",
    "certify:brain-providers": "node scripts/certify-brain-providers.mjs",
    "brain:doctor": "node scripts/brain-doctor.mjs",
    "certify:hybrid-router": "node scripts/certify-hybrid-router.mjs",
    "certify:brain": "npm run certify:brain-providers && npm run certify:hybrid-router",
    "certify:voice-gate": "node scripts/certify-voice-gate.mjs && node scripts/certify-speaker-verification.mjs",
    "voice:gate:doctor": "node scripts/voice-gate-doctor.mjs",
    "certify:diarization-native": "node scripts/certify-speaker-diarization-native.mjs",
    "certify:speaker-verification": "node scripts/certify-speaker-verification.mjs",
    "certify:acoustic-front-end": "tsx scripts/certify-acoustic-front-end.ts",
    "certify:mic-arbitration": "node scripts/certify-mic-arbitration.mjs",
    "certify:tool-domain-router": "node scripts/certify-tool-domain-router.mjs",
    "certify:capability-policy": "node scripts/certify-capability-policy.mjs",
    "certify:lumia-architecture": "npm run certify:voice-gate && npm run certify:acoustic-front-end && npm run certify:mic-arbitration && npm run certify:tool-domain-router && npm run certify:capability-policy && npm run certify:privacy-redaction && npm run certify:wake-engine",
    "certify:privacy-redaction": "node scripts/certify-privacy-redaction.mjs",
    "wake:doctor": "node scripts/wake-engine-doctor.mjs",
    "certify:wake-engine": "node scripts/certify-wake-engine.mjs",
    "meeting:doctor": "node scripts/meeting-doctor.mjs",
    "certify:meeting-store": "node scripts/certify-meeting-store.mjs",
    "certify:meeting-teams": "node scripts/certify-teams-transcript.mjs",
    "certify:meeting-reconcile": "node scripts/certify-meeting-reconcile.mjs",
    "certify:meeting-intelligence": "node scripts/certify-meeting-intelligence.mjs",
    "certify:meeting-service": "node scripts/certify-meeting-service.mjs",
    "certify:meeting-query": "node scripts/certify-meeting-query.mjs",
    "certify:meeting-platform": "node scripts/certify-meeting-platform-adapters.mjs",
    "certify:meeting": "npm run certify:meeting-store && npm run certify:meeting-teams && npm run certify:meeting-reconcile && npm run certify:meeting-intelligence && npm run certify:meeting-service && npm run certify:meeting-query && npm run certify:meeting-platform"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@anthropic-ai/sdk": "^0.115.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@picovoice/porcupine-web": "^4.0.1",
    "@picovoice/web-voice-processor": "^4.0.10",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.4",
    "dompurify": "^3.4.12",
    "framer-motion": "^12.43.0",
    "kokoro-js": "^1.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "ws": "^8.21.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
